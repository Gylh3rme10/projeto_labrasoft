<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebApplication1.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Sistema de Bolsistas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>

    <form id="form1" runat="server">

        <!-- Título -->
        <header class="text-center mt-4">
            <h1>Gestão de Bolsistas</h1>
            <hr />
        </header>

        <!-- Barra de navegação -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border rounded mb-4">
            <div class="container">

                <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <div class="navbar-nav">

                        <asp:HyperLink
                            ID="hlCadastro"
                            runat="server"
                            NavigateUrl="~/CadastroBolsista.aspx"
                            CssClass="nav-link">
                            Cadastro
                        </asp:HyperLink>

                        <asp:HyperLink
                            ID="hlExemplo"
                            runat="server"
                            NavigateUrl="~/BolsistaExemplo.aspx"
                            CssClass="nav-link">
                            Bolsista Exemplo
                        </asp:HyperLink>

                         <asp:HyperLink
                             ID="hlCadCoord"
                             runat="server"
                             NavigateUrl="~/CadastroCoordenadores.aspx"
                             CssClass="nav-link">
                             Cadastro de Coordenadores
                         </asp:HyperLink>

                         <asp:HyperLink
                             ID="HyperLink1"
                             runat="server"
                             NavigateUrl="~/CadastroProjeto.aspx"
                             CssClass="nav-link">
                             Projetos
                         </asp:HyperLink>
                    </div>
                </div>

            </div>
        </nav>

        <!-- Conteúdo das páginas -->
        <div class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>